          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Calculate which appointments need reminders\nconst now = new Date();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const appointmentDate = new Date(item.json.Date + ' ' + item.json.Time);\n  const hoursDiff = (appointmentDate - now) / (1000 * 60 * 60);\n  \n  let reminderType = null;\n  let shouldSend = false;\n  \n  // 48-hour reminder (between 47-49 hours before)\n  if (hoursDiff >= 47 && hoursDiff <= 49 && !item.json['48hr_Reminder_Sent']) {\n    reminderType = '48hr';\n    shouldSend = true;\n  }\n  // 24-hour reminder (between 23-25 hours before, only if not confirmed)\n  else if (hoursDiff >= 23 && hoursDiff <= 25 && !item.json['24hr_Reminder_Sent'] && item.json.Confirmed !== 'Yes') {\n    reminderType = '24hr';\n    shouldSend = true;\n  }\n  // 2-hour reminder (between 1.5-2.5 hours before)\n  else if (hoursDiff >= 1.5 && hoursDiff <= 2.5 && !item.json['2hr_Reminder_Sent']) {\n    reminderType = '2hr';\n    shouldSend = true;\n  }\n  \n  if (shouldSend) {\n    results.push({\n      json: {\n        ...item.json,\n        reminderType,\n        hoursDiff: Math.round(hoursDiff * 10) / 10,\n        appointmentDateTime: appointmentDate.toISOString()\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "code-calculate-reminders",
      "name": "Calculate Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
