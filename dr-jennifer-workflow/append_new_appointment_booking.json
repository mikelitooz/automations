      "name": "HTTP: Trigger Waitlist (Reschedule)"
    },
    {
      "parameters": {
        "content": "**CAL.COM UNIFIED EVENT HANDLER**\n\nHandles complete appointment lifecycle:\n✅ BOOKING_CREATED → Append to Google Sheets\n✅ BOOKING_CANCELLED → Update status + Trigger waitlist\n✅ BOOKING_RESCHEDULED → Update status + Trigger waitlist\n\nAll Cal.com events managed in one workflow!",
        "height": 1032,
        "width": 1704,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -176,
        96
      ],
      "typeVersion": 1,
      "id": "53ec3c82-736f-40d6-8dc2-2d872364ea6d",
      "name": "Sticky Note: Overview"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Unified Cal.com Webhook Parser\n * Handles BOOKING_CREATED, BOOKING_CANCELLED, BOOKING_RESCHEDULED\n */\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  try {\n    const webhook = item.json;\n    \n    // Determine event type\n    const eventType = webhook.triggerEvent;\n    \n    // Extract attendee info (patient)\n    const attendee = webhook.attendees && webhook.attendees[0] ? webhook.attendees[0] : {};\n    const patientEmail = attendee.email || \"\";\n    const patientName = attendee.name || \"\";\n    const patientPhone = attendee.phoneNumber || \"\";\n    \n    // Extract appointment details\n    const startTime = new Date(webhook.startTime);\n    \n    // Human-readable formats\n    const humanDate = startTime.toLocaleDateString('en-US', {\n      weekday: 'long',\n      month: 'long',\n      day: 'numeric',\n    });\n    const humanTime = startTime.toLocaleTimeString('en-US', {\n      hour: '2-digit',\n      minute: '2-digit',\n      hour12: true\n    });\n    \n    // ISO format for scheduling\n    const isoTimeFormat = webhook.startTime;\n    \n    // Extract doctor name from title/organizer\n    const doctorMatch = webhook.eventTitle?.match(/Dr\\.?\\s*\\w+/i);\n    const doctorName = doctorMatch ? doctorMatch[0].trim() : (webhook.organizer?.name || \"Dr. Jennifer\");\n    \n    // Appointment type\n    const appointmentType = webhook.userFieldsResponses?.appointmentType?.value || \n                           webhook.responses?.appointmentType?.value || \n                           webhook.description || \n                           \"Consultation\";\n    \n    // For reschedule: Get new time if available\n    let newDate = null;\n    let newTime = null;\n    let newIsoTime = null;\n    \n    if (eventType === \"BOOKING_RESCHEDULED\" && webhook.rescheduleEndTime) {\n      const newStartTime = new Date(webhook.rescheduleEndTime);\n      newDate = newStartTime.toLocaleDateString('en-US', {\n        weekday: 'long',\n        month: 'long',\n        day: 'numeric',\n      });\n      newTime = newStartTime.toLocaleTimeString('en-US', {\n        hour: '2-digit',\n        minute: '2-digit',\n        hour12: true\n      });\n      newIsoTime = webhook.rescheduleEndTime;\n    }\n    \n    console.log(`📅 ${eventType}: ${patientName} - ${humanDate} at ${humanTime}`);\n    \n    results.push({\n      json: {\n        // Event metadata\n        eventType: eventType,\n        bookingId: webhook.bookingId || webhook.uid,\n        appointmentUid: webhook.uid,\n        \n        // Patient info\n        patientEmail: patientEmail,\n        patientName: patientName,\n        patientPhone: patientPhone,\n        \n        // Appointment details (original/current)\n        appointmentDate: humanDate,\n        appointmentTime: humanTime,\n        isoTimeFormat: isoTimeFormat,\n        doctorName: doctorName,\n        appointmentType: appointmentType,\n        \n        // For reschedule: new appointment details\n        newDate: newDate,\n        newTime: newTime,\n        newIsoTime: newIsoTime,\n        \n        // Full webhook for reference\n        rawWebhook: webhook\n      }\n    });\n    \n  } catch (error) {\n    console.error(`❌ Error parsing Cal.com webhook:`, error.message);\n    results.push({\n      json: {\n        error: error.message,\n        rawData: item.json\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        512
      ],
