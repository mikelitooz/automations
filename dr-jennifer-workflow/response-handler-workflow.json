    {
      "parameters": {
        "jsCode": "/**\n * STEP 1: Pattern Matching for Explicit 1/2/3 Responses\n * Fast, free, handles 90% of cases\n * \n * FIX: Properly merge Gmail data with Google Sheets lookup data\n * Ensures only the patient who replied gets their appointment updated\n */\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  try {\n    const data = item.json;\n    \n    // Extract email body from Gmail fields\n    const emailBody = (\n      data.textPlain || \n      data.body || \n      data.snippet || \n      \"\"\n    ).toLowerCase().trim();\n    \n    const fromEmail = data.from;\n    \n    // Validate we have patient data from Google Sheets lookup\n    // The 'Lookup Patient' node should have filtered by email and returned only this patient's data\n    if (!data.Patient_Name || !data.Patient_Email) {\n      console.warn(`⚠️ Patient not found for email: ${fromEmail}`);\n      results.push({\n        json: {\n          from: fromEmail,\n          emailBody: emailBody,\n          responseType: \"patient_not_found\",\n          classificationMethod: \"error\",\n          aiUsed: false,\n          errorMessage: \"Patient email not found in appointments\"\n        }\n      });\n      continue;\n    }\n    \n    // Additional validation: ensure the patient email from sheet matches the email sender\n    if (data.Patient_Email && fromEmail && !fromEmail.toLowerCase().includes(data.Patient_Email.toLowerCase())) {\n      console.warn(`⚠️ Email mismatch: Sender ${fromEmail} does not match patient ${data.Patient_Email}`);\n      results.push({\n        json: {\n          from: fromEmail,\n          emailBody: emailBody,\n          Patient_Email: data.Patient_Email,\n          responseType: \"patient_not_found\",\n          classificationMethod: \"error\",\n          aiUsed: false,\n          errorMessage: \"Email sender does not match appointment patient\"\n        }\n      });\n      continue;\n    }\n    \n    // Check if appointment is in the past\n    const apptDate = new Date(data.Date + \" \" + data.Time);\n    if (apptDate < new Date()) {\n      console.log(`⏰ Appointment already passed for ${data.Patient_Name}`);\n      results.push({\n        json: {\n          ...data,\n          responseType: \"past_appointment\",\n          classificationMethod: \"date_check\",\n          aiUsed: false,\n          emailBody: emailBody,\n          fromEmail: fromEmail\n        }\n      });\n      continue;\n    }\n    \n    let responseType = null;\n    \n    // ===== PRIMARY: Check for explicit \"1\", \"2\", or \"3\" =====\n    if (/\\b1\\b/.test(emailBody)) {\n      responseType = \"confirm\";\n      console.log(`✅ Pattern matched: \"1\" for ${data.Patient_Name}`);\n    } else if (/\\b2\\b/.test(emailBody)) {\n      responseType = \"cancel\";\n      console.log(`❌ Pattern matched: \"2\" for ${data.Patient_Name}`);\n    } else if (/\\b3\\b/.test(emailBody)) {\n      responseType = \"reschedule\";\n      console.log(`🔄 Pattern matched: \"3\" for ${data.Patient_Name}`);\n    }\n    \n    // If found, return immediately (skip AI)\n    if (responseType) {\n      results.push({\n        json: {\n          ...data,\n          responseType,\n          classificationMethod: \"pattern_matching\",\n          aiUsed: false,\n          emailBody: emailBody,\n          fromEmail: fromEmail,\n          processedAt: new Date().toISOString()\n        }\n      });\n    } else {\n      // No pattern found - needs AI classification\n      console.log(`🤖 No pattern found, needs AI for: ${data.Patient_Name}`);\n      results.push({\n        json: {\n          ...data,\n          responseType: \"needs_ai_classification\",\n          classificationMethod: \"pending_ai\",\n          aiUsed: true,\n          emailBody: emailBody,\n          fromEmail: fromEmail,\n          processedAt: new Date().toISOString()\n        }\n      });\n    }\n    \n  } catch (error) {\n    console.error(`❌ Error processing email:`, error.message);\n    results.push({\n      json: {\n        ...item.json,\n        responseType: \"error\",\n        classificationMethod: \"error\",\n        errorMessage: error.message\n      }\n    });\n  }\n}\n\nconsole.log(`\n📊 Pattern Matching Summary:\n  - Processed: ${results.length} emails\n  - Pattern matched: ${results.filter(r => !r.json.aiUsed).length}\n  - Needs AI: ${results.filter(r => r.json.aiUsed).length}\n`);\n\nreturn results;\n"
      },
