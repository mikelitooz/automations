    {
      "parameters": {
        "jsCode": "/**\n * Parse AI Response from Claude API\n * Extract classification: CONFIRM, CANCEL, RESCHEDULE, or UNKNOWN\n */\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  try {\n    const data = item.json;\n    \n    // Extract AI response text\n    const aiResponseText = data.content && data.content[0] && data.content[0].text \n      ? data.content[0].text.toUpperCase().trim() \n      : \"UNKNOWN\";\n    \n    console.log(`🤖 AI Response: \"${aiResponseText}\"`);\n    \n    let responseType = \"unknown\";\n    \n    // Parse AI response\n    if (aiResponseText.includes(\"CONFIRM\")) {\n      responseType = \"confirm\";\n    } else if (aiResponseText.includes(\"CANCEL\")) {\n      responseType = \"cancel\";\n    } else if (aiResponseText.includes(\"RESCHEDULE\")) {\n      responseType = \"reschedule\";\n    } else {\n      responseType = \"unknown\";\n    }\n    \n    console.log(`✅ AI classified as: ${responseType}`);\n    \n    results.push({\n      json: {\n        ...data,\n        responseType,\n        classificationMethod: \"ai_claude_haiku\",\n        aiResponse: aiResponseText,\n        processedAt: new Date().toISOString()\n      }\n    });\n    \n  } catch (error) {\n    console.error(`❌ Error parsing AI response:`, error.message);\n    results.push({\n      json: {\n        ...item.json,\n        responseType: \"unknown\",\n        classificationMethod: \"ai_error\",\n        errorMessage: error.message\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
