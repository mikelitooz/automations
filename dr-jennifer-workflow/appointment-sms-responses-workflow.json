    {
      "parameters": {
        "jsCode": "// Parse Twilio webhook data\nconst body = $input.first().json.body;\n\n// Twilio sends form-encoded data, parse it\nlet twilioData = {};\nif (typeof body === 'string') {\n  const params = new URLSearchParams(body);\n  twilioData = {\n    from: params.get('From'),\n    to: params.get('To'),\n    body: params.get('Body'),\n    messageSid: params.get('MessageSid')\n  };\n} else {\n  twilioData = body;\n}\n\n// Normalize patient response\nconst messageBody = twilioData.body.trim().toUpperCase();\nlet responseType = 'unknown';\n\nif (messageBody === '1' || messageBody.includes('CONFIRM')) {\n  responseType = 'confirm';\n} else if (messageBody === '2' || messageBody.includes('CANCEL')) {\n  responseType = 'cancel';\n} else if (messageBody === '3' || messageBody.includes('RESCHEDULE')) {\n  responseType = 'reschedule';\n}\n\nreturn [{\n  json: {\n    patientPhone: twilioData.from,\n    responseType,\n    originalMessage: twilioData.body,\n    receivedAt: new Date().toISOString(),\n    messageSid: twilioData.messageSid\n  }\n}];"
      },
