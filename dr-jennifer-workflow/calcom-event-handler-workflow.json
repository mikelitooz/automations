    {
      "parameters": {
        "jsCode": "/**\n * Parse Cal.com webhook payload\n * Extract key appointment details\n */\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  try {\n    const webhook = item.json;\n    \n    // Determine event type\n    const eventType = webhook.triggerEvent; // \"BOOKING_CANCELLED\" or \"BOOKING_RESCHEDULED\"\n    \n    // Extract attendee info (patient)\n    const attendee = webhook.attendees && webhook.attendees[0] ? webhook.attendees[0] : {};\n    const patientEmail = attendee.email || \"\";\n    const patientName = attendee.name || \"\";\n    const patientPhone = attendee.phoneNumber || \"\";\n    \n    // Extract appointment details\n    const startTime = new Date(webhook.startTime);\n    const appointmentDate = startTime.toISOString().split('T')[0]; // \"2025-11-04\"\n    const appointmentTime = startTime.toLocaleTimeString('en-US', { \n      hour: '2-digit', \n      minute: '2-digit',\n      hour12: true \n    }); // \"02:15 PM\"\n    \n    // Organizer is the doctor\n    const doctorName = webhook.organizer?.name || \"Dr. Jennifer\";\n    \n    // Appointment type from event description\n    const appointmentType = webhook.description || webhook.eventTitle || \"General Consultation\";\n    \n    // For reschedule: Get new time if available\n    let newDate = null;\n    let newTime = null;\n    \n    if (eventType === \"BOOKING_RESCHEDULED\" && webhook.rescheduleEndTime) {\n      const newStartTime = new Date(webhook.rescheduleEndTime);\n      newDate = newStartTime.toISOString().split('T')[0];\n      newTime = newStartTime.toLocaleTimeString('en-US', { \n        hour: '2-digit', \n        minute: '2-digit',\n        hour12: true \n      });\n    }\n    \n    console.log(`📅 ${eventType}: ${patientName} - ${appointmentDate} at ${appointmentTime}`);\n    \n    results.push({\n      json: {\n        eventType: eventType,\n        patientEmail: patientEmail,\n        patientName: patientName,\n        patientPhone: patientPhone,\n        appointmentDate: appointmentDate,\n        appointmentTime: appointmentTime,\n        doctorName: doctorName,\n        appointmentType: appointmentType,\n        bookingId: webhook.bookingId || webhook.uid,\n        // For reschedule\n        newDate: newDate,\n        newTime: newTime,\n        // Full webhook for reference\n        rawWebhook: webhook\n      }\n    });\n    \n  } catch (error) {\n    console.error(`❌ Error parsing Cal.com webhook:`, error.message);\n    results.push({\n      json: {\n        error: error.message,\n        rawData: item.json\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-960, 400],
      "id": "parse-webhook",
      "name": "Parse Cal.com Webhook"
    },
