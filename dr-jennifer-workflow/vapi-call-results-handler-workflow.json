      "id": "a1b2c3d4-e5f6-7890-abcd-1234567890ab",
      "name": "Webhook: Vapi Results",
      "webhookId": "vapi-call-results",
      "notes": "Receives end-of-call-report from Vapi with structured outcome data"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Parse Vapi webhook payload and extract structured outcome\n * \n * Expected payload structure:\n * {\n *   message: {\n *     type: \"end-of-call-report\",\n *     endedReason: \"customer-ended-call\" | \"assistant-ended-call\" | \"voicemail-reached\",\n *     call: { \n *       id, status, phoneNumberId, \n *       customer: { \n *         number, name,\n *         extension: { appointmentUid, isoTimeFormat, patientEmail }\n *       } \n *     },\n *     analysis: {\n *       summary: \"...\",\n *       structuredData: { outcome, patientResponse, needsFollowup, appointmentConfirmed }\n *     },\n *     artifact: { transcript, recording: { url }, messages }\n *   }\n * }\n */\n\nconst payload = $input.first().json.body;\nconst message = payload.message;\n\n// Validate webhook type\nif (message.type !== \"end-of-call-report\") {\n  console.log(`⚠️ Ignoring webhook type: ${message.type}`);\n  return [];\n}\n\n// Extract call data\nconst callData = message.call || {};\nconst customer = callData.customer || {};\nconst customerExtension = customer.extension || {};\nconst analysis = message.analysis || {};\nconst structuredData = analysis.structuredData || {};\nconst artifact = message.artifact || {};\n\n// Extract patient identifiers\nconst patientPhone = customer.number || \"\";\nconst patientName = customer.name || \"\";\nconst appointmentUid = customerExtension.appointmentUid || \"\";\nconst isoTimeFormat = customerExtension.isoTimeFormat || \"\";\nconst patientEmail = customerExtension.patientEmail || \"\";\n\n// Determine outcome (use structuredData if available, otherwise infer from endedReason)\nlet outcome = structuredData.outcome || \"unanswered\";\nif (message.endedReason === \"voicemail-reached\" && outcome !== \"confirmed\") {\n  outcome = \"unanswered\";\n}\n\n// Prepare output\nconst result = {\n  // Call metadata\n  callId: callData.id,\n  callStatus: callData.status,\n  endedReason: message.endedReason,\n  \n  // Patient identification (multiple fields for reliable matching)\n  Appointment_Uid: appointmentUid,\n  Patient_Phone: patientPhone,\n  Patient_Email: patientEmail,\n  Patient_Name: patientName,\n  ISO_Time_Format: isoTimeFormat,\n  \n  // Structured outcome data\n  outcome: outcome,\n  patientResponse: structuredData.patientResponse || \"No response captured\",\n  needsFollowup: structuredData.needsFollowup || false,\n  appointmentConfirmed: structuredData.appointmentConfirmed || false,\n  \n  // Call analysis\n  callSummary: analysis.summary || \"No summary available\",\n  \n  // Call artifacts\n  transcriptUrl: artifact.transcript || \"\",\n  recordingUrl: artifact.recording?.url || \"\",\n  \n  // Timestamps\n  callCompletedAt: new Date().toISOString(),\n  \n  // Raw payload (for debugging)\n  rawPayload: JSON.stringify(payload, null, 2)\n};\n\nconsole.log(`\n📞 Vapi Call Result Received:\n  - Call ID: ${result.callId}\n  - Appointment UID: ${result.Appointment_Uid}\n  - Patient Phone: ${result.Patient_Phone}\n  - Patient Email: ${result.Patient_Email}\n  - Outcome: ${result.outcome}\n  - Confirmed: ${result.appointmentConfirmed}\n  - Needs Follow-up: ${result.needsFollowup}\n`);\n\nreturn [{ json: result }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
