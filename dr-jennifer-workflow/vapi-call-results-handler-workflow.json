    {
      "parameters": {
        "jsCode": "// Send Cal.com reschedule link via email\n// This node prepares data for email workflow or direct email send\n\nconst data = $input.first().json;\n\nreturn [{\n  json: {\n    ...data,\n    action: \"send_reschedule_link\",\n    emailSubject: \"Reschedule Your Appointment with Dr. Jennifer\",\n    emailBody: `Hi ${data.Patient_Name || 'there'},\\n\\nThank you for speaking with us about your appointment. As discussed, we'd be happy to help you reschedule.\\n\\nPlease use the link below to choose a new time that works better for you:\\n\\n[Cal.com Reschedule Link]\\n\\nIf you have any questions, please call us at [Office Phone].\\n\\nBest regards,\\nDr. Jennifer's Office`\n  }\n}];"
      },
