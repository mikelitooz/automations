        "errorMessage": "Invalid lead data - email is required"
      },
      "id": "error-invalid",
      "name": "Stop - Invalid Data",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [690, 420]
    },
    {
