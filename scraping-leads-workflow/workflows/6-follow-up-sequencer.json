          "mode": "id",
          "value": "Raw Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Follow-Up Count": "={{ parseInt($json['Follow-Up Count'] || 0) + 1 }}",
            "Last Contact Date": "={{ $now.toISO() }}",
            "Follow-Up Status": "={{ parseInt($json['Follow-Up Count'] || 0) + 1 >= 3 ? 'Completed' : 'Active' }}"
          },
          "matchingColumns": ["Lead ID"]
        },
        "options": {}
      },
      "id": "update-followup-status",
      "name": "Update Follow-Up Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1560, 300]
    }
  ],
